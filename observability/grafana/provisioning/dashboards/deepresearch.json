{
  "uid": "deepresearch",
  "title": "DeepResearch",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "采集服务可用性",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "min(up{job=~\"deepresearch-api|deepresearch-worker\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "队列深度",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "deepresearch_queue_depth or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "任务成功率（近 5 分钟）",
      "description": "仅在该窗口内有完成、证据不足或失败任务时计算；无任务时显示 N/A，避免把无样本误读为 0%。",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "(sum(rate(deepresearch_runs_total{status=~\"completed|insufficient\"}[5m])) / sum(rate(deepresearch_runs_total[5m]))) and (sum(increase(deepresearch_runs_total[5m])) > 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "失败类别",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(deepresearch_failures_total[5m])) by (category) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "任务时延 P95",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(deepresearch_node_duration_seconds_bucket[5m])) by (le)) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token 消耗",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(deepresearch_tokens_total[5m])) by (kind) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "图片理解耗时 P95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(deepresearch_vision_duration_seconds_bucket[5m])))",
          "legendFormat": "{{kind}}{{source}} {{outcome}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "图片理解错误率",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(deepresearch_vision_calls_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(deepresearch_vision_calls_total[5m])), 0.000001)",
          "legendFormat": "{{kind}}{{source}} {{outcome}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "视觉 Token 用量",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (kind) (increase(deepresearch_vision_tokens_total[1h]))",
          "legendFormat": "{{kind}}{{source}} {{outcome}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "检索结果分类",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (source, outcome) (increase(deepresearch_retrieval_outcomes_total[1h]))",
          "legendFormat": "{{kind}}{{source}} {{outcome}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "兜底原因分布",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(deepresearch_fallbacks_total[1h]))",
          "legendFormat": "{{kind}}{{source}} {{outcome}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "图片理解调用量",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(deepresearch_vision_calls_total[1h]))",
          "legendFormat": "{{kind}}{{source}} {{outcome}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
