# Copy to .env. Secrets are read only by the backend.
LLM_MODEL_ID=deepseek-v4-flash
# Uses the same DeepSeek base URL and API key for task attachments and image knowledge-base files.
VISION_MODEL_ID=deepseek-v4-flash-vision-exp
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# DeepSeek optional provider parameters; remove for a different provider.
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BASE_URL=https://api.openai-proxy.org/v1
EMBEDDING_API_KEY=
# Validate the actual returned dimension. Set SEND_EMBEDDING_DIMENSIONS=true
# only if your provider supports the dimensions request parameter.
EMBEDDING_DIMENSION=3072
SEND_EMBEDDING_DIMENSIONS=false
# Web search provider: deepseek (default), bocha, or auto.
# DeepSeek uses the configured LLM API key through its /responses web_search tool.
WEB_SEARCH_PROVIDER=deepseek
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_API_KEY=
APP_PORT=8080
# Optional JSON map of trusted source domains, for example {"nist.gov":"official"}.
SOURCE_TRUST_OVERRIDES={}
WEB_CACHE_TTL_HOURS=168
AUTO_SAVE_SEMANTIC_MEMORY=false
MAX_REFLECTION_ROUNDS=2
MAX_SEARCH_CALLS=12
# Deep research reads up to this many results per query, then caps all unique web candidates.
WEB_RESULTS_PER_QUERY=8
MAX_WEB_CANDIDATES=24
WEB_SEARCH_CONCURRENCY=3
WEB_FETCH_CONCURRENCY=6
MAX_RUN_SECONDS=600
MAX_CONCURRENT_RUNS=2
MAX_LLM_CONCURRENCY=3
# Backend task progress logs written to `docker compose logs -f backend`.
TASK_LOG_LEVEL=INFO
# Only inject historical semantic memories whose cosine similarity meets this threshold.
SEMANTIC_MEMORY_MIN_SCORE=0.35
# Keep this many recent reports in detail and this many prior questions as the thread outline.
# They guide follow-up understanding only and are never treated as current research evidence.
CONVERSATION_RECENT_RUNS=6
CONVERSATION_TURN_LIMIT=30
REQUEST_TIMEOUT_SECONDS=90
MILVUS_URI=http://127.0.0.1:19530
DATA_DIR=./data
# Explicit offline fixtures only. Never enabled automatically on API failure.
DEMO_MODE=false
# Enterprise single-node demonstration: docker compose up -d --build --wait
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8180/realms/deepresearch
OIDC_AUDIENCE=deepresearch-api
OIDC_JWKS_URL=http://keycloak:8080/realms/deepresearch/protocol/openid-connect/certs
# Development only; use an external secret manager in deployed environments.
DEVELOPMENT_JWT_SECRET=development-only-secret-must-be-32-bytes
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_BACKEND=local
MAX_JOB_RETRIES=2
OTEL_EXPORTER_OTLP_ENDPOINT=

# No daily query/token quota. This is a relevance threshold, not a usage cap.
RAG_MIN_VECTOR_SCORE=0.2
WORKSPACE_CONCURRENT_RUN_LIMIT=2
DOCUMENT_SCAN_MODE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Enterprise document originals and quarantine are stored in this S3-compatible object store.
# The default Compose sets these values for its internal MinIO service.
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=deepresearch-documents
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# PostgreSQL application database password for the deepresearch user.
POSTGRES_PASSWORD=

# PostgreSQL password used only by Keycloak persistence.
KEYCLOAK_DB_PASSWORD=

# Initial password for the Keycloak admin user.
KEYCLOAK_ADMIN_PASSWORD=

# Root password for MinIO, which backs Milvus object storage.
MINIO_ROOT_PASSWORD=

# Initial password for the Grafana admin user.
GRAFANA_ADMIN_PASSWORD=

# Optional Feishu group-bot webhook for Alertmanager notifications. Keep empty to disable delivery.
FEISHU_WEBHOOK_URL=
