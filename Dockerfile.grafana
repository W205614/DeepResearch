# Fixed upstream sources; retain all13 plugins and their complete official assets.
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS toolchain
ARG GOPROXY=https://proxy.golang.org
ENV GOPROXY=${GOPROXY} GOTOOLCHAIN=local CGO_ENABLED=0 GOMAXPROCS=2 GOFLAGS=-p=2 GOMEMLIMIT=768MiB
RUN apk add --no-cache git python3
FROM toolchain AS plugins
COPY deployment/vendors/grafana/build_backends.py deployment/vendors/grafana/plugin-modules.json /tools/
COPY deployment/vendors/grafana/plugins/ /locks/
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    python3 /tools/build_backends.py --inventory /tools/plugin-modules.json --locks /locks --output /out
FROM toolchain AS assets
COPY deployment/vendors/grafana/unpack_official_plugins.py deployment/vendors/grafana/official-plugins.lock.json /tools/
ADD --checksum=sha256:5bf571db8389b042064411943e7e2e898829d1b76c193cebf0017cc615452295 https://grafana.com/api/plugins/stackdriver/versions/12.6.4/download?os=linux&arch=amd64 /downloads/stackdriver-12.6.4.zip
ADD --checksum=sha256:0d1f5794d34febc54e55ac05ac92ea4ad6548ec3f2521865116c9ed46f7d55e9 https://grafana.com/api/plugins/loki/versions/13.2.2/download?os=linux&arch=amd64 /downloads/loki-13.2.2.zip
ADD --checksum=sha256:6d4cd5354301d80e2afa3d93b4f1a4ea30222df33387418e797c964b5bfcf252 https://grafana.com/api/plugins/zipkin/versions/12.4.11/download?os=linux&arch=amd64 /downloads/zipkin-12.4.11.zip
ADD --checksum=sha256:dc57642e289ba81a2dd7179b0f7e945966f5db1234c7aaf9e470a2db34207ce1 https://grafana.com/api/plugins/jaeger/versions/13.0.5/download?os=linux&arch=amd64 /downloads/jaeger-13.0.5.zip
ADD --checksum=sha256:70ad88d3a304c677ef59603adb644ff9958d3abaae773793b8710d69651845c6 https://grafana.com/api/plugins/mysql/versions/13.1.4/download?os=linux&arch=amd64 /downloads/mysql-13.1.4.zip
ADD --checksum=sha256:117edd789f96f4dc6f2e79bef6be3ea10e9ffec775e81e05c16954bcc10cc3a0 https://grafana.com/api/plugins/prometheus/versions/13.2.4/download?os=linux&arch=amd64 /downloads/prometheus-13.2.4.zip
ADD --checksum=sha256:24a2a04189517aec328dc13fa13aecab7bc52a373b8b36c552e2649502e8d1eb https://grafana.com/api/plugins/elasticsearch/versions/12.9.3/download?os=linux&arch=amd64 /downloads/elasticsearch-12.9.3.zip
ADD --checksum=sha256:e783acd5901e11d6d4f102d9bd5bdd75be61ae7c9c03c770a6a0c534e9033281 https://grafana.com/api/plugins/opentsdb/versions/13.0.6/download?os=linux&arch=amd64 /downloads/opentsdb-13.0.6.zip
ADD --checksum=sha256:4c7482151acda930ff35b45bafa0d90ec8636c8f92350a20a287496bf7e202b0 https://grafana.com/api/plugins/mssql/versions/13.0.7/download?os=linux&arch=amd64 /downloads/mssql-13.0.7.zip
ADD --checksum=sha256:76f23425dd0747e65479ee02020748d37eb7f11f7d0740a0c81eebcb29c1cbaa https://grafana.com/api/plugins/grafana-pyroscope-datasource/versions/13.0.8/download?os=linux&arch=amd64 /downloads/grafana-pyroscope-datasource-13.0.8.zip
ADD --checksum=sha256:640a19f8494d41b2d4f12b10670348506698fd3b0a5ac9e32e9601cb65b40897 https://grafana.com/api/plugins/influxdb/versions/13.1.7/download?os=linux&arch=amd64 /downloads/influxdb-13.1.7.zip
ADD --checksum=sha256:d34f44bd13213502de4394955fcc170d70fb822531c181bff0179f216c35a0e0 https://grafana.com/api/plugins/grafana-postgresql-datasource/versions/13.0.4/download?os=linux&arch=amd64 /downloads/grafana-postgresql-datasource-13.0.4.zip
ADD --checksum=sha256:692135f83a7430e54dd2aeaf89da7c3f7b7561ea7826582294910d7c59842bd1 https://grafana.com/api/plugins/tempo/versions/13.3.0/download?os=linux&arch=amd64 /downloads/tempo-13.3.0.zip
RUN python3 /tools/unpack_official_plugins.py --lock /tools/official-plugins.lock.json --downloads /downloads --output /official-assets --hashes /official-asset-hashes.json
# Only small manifests are needed by the compiler; all assets go to runtime below.
RUN mkdir /reviewed-manifests && for directory in /official-assets/*; do name="$(basename "$directory")"; mkdir "/reviewed-manifests/$name"; cp "$directory/MANIFEST.txt" "/reviewed-manifests/$name/"; done
FROM toolchain AS build
WORKDIR /source
ADD --checksum=sha256:31f1b1f049fa92201f07d5c31e248704060bfad3adf280edfee042bba1eeb676 https://codeload.github.com/grafana/grafana/tar.gz/6259becc8e86265fdf35a73e08eef5bd92b5cd73 /tmp/main.tar.gz
RUN tar -xzf /tmp/main.tar.gz --strip-components=1 && git init && \
    git remote add origin https://github.com/grafana/grafana.git && git config core.hooksPath /dev/null && \
    (git -c http.version=HTTP/1.1 -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=60 fetch --depth=1 origin refs/tags/v13.2.4:refs/tags/v13.2.4 || \
     git -c http.version=HTTP/1.1 -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=60 fetch --depth=1 origin refs/tags/v13.2.4:refs/tags/v13.2.4) && \
    test "$(git rev-parse 'refs/tags/v13.2.4^{commit}')" = af4a33e3786594ad72f72d97e6744010330c2977 && \
    git reset --mixed af4a33e3786594ad72f72d97e6744010330c2977
COPY deployment/vendors/grafana/main/ ./
COPY --from=plugins /out/plugins/ /rebuilt/
COPY --from=assets /reviewed-manifests/ /reviewed-manifests/
COPY deployment/vendors/grafana/prepare_rebuild.py deployment/vendors/grafana/plugin-modules.json /tools/
RUN python3 /tools/prepare_rebuild.py --inventory /tools/plugin-modules.json --upstream /reviewed-manifests --rebuilt /rebuilt --source /source/pkg/plugins/manager/signature/manifest.go --output /generated && \
    cp /generated/*.go /source/pkg/plugins/manager/signature/
COPY deployment/vendors/grafana/reviewed_backend_verifier.go deployment/vendors/grafana/reviewed_backend_verifier_test.go /source/pkg/plugins/manager/signature/
RUN gofmt -w /source/pkg/plugins/manager/signature/reviewed_backend*.go
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go test ./pkg/plugins/manager/signature -run TestMaintainerReviewedBackendIntegrity -count=1 && \
    go build -mod=readonly -buildvcs=true -trimpath \
      -ldflags='-s -w -X main.version=13.2.4 -X main.commit=af4a33e3786594ad72f72d97e6744010330c2977 -X main.buildBranch=maintainer-security -X main.buildstamp=1791891415' \
      -o /out/grafana ./pkg/cmd/grafana && \
    go version -m /out/grafana > /out/build-info.txt && \
    grep -F 'vcs.revision=af4a33e3786594ad72f72d97e6744010330c2977' /out/build-info.txt
FROM grafana/grafana:13.2.4@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f
USER 0
RUN apk add --no-cache 'brotli-libs=1.2.1-r0' 'curl=8.23.0-r0' 'libcurl=8.23.0-r0' \
    'libssl3=3.5.9-r0' 'libcrypto3=3.5.9-r0' 'zlib=1.3.2-r1' \
    'musl=1.2.6-r3' 'musl-utils=1.2.6-r3' && \
    rm -rf /usr/share/grafana/data/plugins-bundled && mkdir -p /usr/share/grafana/data/plugins-bundled
COPY --from=assets /official-assets/ /usr/share/grafana/data/plugins-bundled/
COPY --from=plugins /out/plugins/ /usr/share/grafana/data/plugins-bundled/
COPY --from=build /out/grafana /usr/share/grafana/bin/grafana
COPY --from=build /out/build-info.txt /usr/share/deepresearch/grafana-build-info.txt
COPY --from=build /generated/rebuild-provenance.json /usr/share/deepresearch/grafana-rebuild-provenance.json
COPY --from=assets /official-asset-hashes.json /usr/share/deepresearch/grafana-official-asset-hashes.json
COPY deployment/vendors/grafana/main-source.lock.json deployment/vendors/grafana/official-plugins.lock.json deployment/vendors/grafana/plugin-modules.json /usr/share/deepresearch/
RUN find /usr/share/grafana/data/plugins-bundled -type f -name '*_linux_amd64' -exec chmod 0755 {} +
USER 472
