FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2 GOMEMLIMIT=512MiB
RUN apk add --no-cache bash coreutils
WORKDIR /source
ADD --checksum=sha256:33d7537d588ea49458b9509bcf4554bdf5ceacc66da71e5caa1058ea3b689c3b https://codeload.github.com/tianon/gosu/tar.gz/6456aaa0f3c854d199d0f037f068eb97515b7513 /tmp/gosu.tar.gz
ADD --checksum=sha256:6ffaef5b0b820070c02253fb27bd07f62d1e501e757f71d8b501f1c8e17d828e https://raw.githubusercontent.com/tianon/fake-git/aaa875961611764a86a21cf80c250929a7786179/fake-git.sh /usr/local/bin/git
# Preserve upstream gosu's own version.go -> v1.19.0 metadata convention.
# Its public tag is "1.19"; the exact official Dockerfile uses this pinned tool
# so scanners recognize the real application version. Never emit (devel).
RUN tar -xzf /tmp/gosu.tar.gz --strip-components=1 \
    && chmod 0755 /usr/local/bin/git && mkdir .git \
    && grep -F 'const Version = "1.19"' version.go
COPY deployment/vendors/gosu/go.mod deployment/vendors/gosu/go.sum ./
# Upstream deliberately retains symbols needed by govulncheck: do not add -s.
RUN --mount=type=cache,target=/go/pkg/mod,id=dr-vendor-go-mod-20261026 \
    --mount=type=cache,target=/root/.cache/go-build,id=dr-vendor-go-build-20261026 \
    export FAKEGIT_GO_REVISION=1.19 FAKEGIT_GO_SEMVER=v1.19.0; \
    go build -mod=readonly -trimpath -buildvcs=true -ldflags='-d -w' -o /out/gosu . \
    && go version -m /out/gosu | tee /tmp/build-info \
    && grep -F 'github.com/tianon/gosu' /tmp/build-info \
    && grep -F 'v1.19.0' /tmp/build-info \
    && ! grep -F '(devel)' /tmp/build-info \
    && /out/gosu --version
FROM postgres:17.11-alpine@sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
COPY --from=build /out/gosu /usr/local/bin/gosu
