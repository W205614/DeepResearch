FROM alpine:3.20

# Quay no longer serves the pinned community image anonymously. Keep the same
# MinIO release and verify the binary published with its official GitHub tag.
RUN apk add --no-cache ca-certificates curl
RUN curl --fail --location --silent --show-error --retry 3 \
      https://github.com/minio/minio/releases/download/RELEASE.2024-05-28T17-19-04Z/minio.linux-amd64.RELEASE.2024-05-28T17-19-04Z \
      --output /usr/local/bin/minio \
    && echo '5708e53878085ab263c333b24fa7e59980425d64a9b085996b58799f9645e1db  /usr/local/bin/minio' | sha256sum -c - \
    && chmod 0755 /usr/local/bin/minio

EXPOSE 9000 9001
