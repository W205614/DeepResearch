# Copy to a private file, configure real values, create Secret deepresearch-python.
# URI-escape credentials. Put postgres-ca.pem in the separate trust Secret.
DATABASE_URL=postgresql://dr_python:REPLACE@REPLACE_PG/deepresearch?sslmode=verify-full&sslrootcert=/run/certs/postgres-ca.pem
REDIS_URL=rediss://REPLACE_ACL_USER:REPLACE@REPLACE_REDIS:6379/0
MILVUS_URI=https://REPLACE_MILVUS:19530
MILVUS_TOKEN=REPLACE
LLM_API_KEY=REPLACE_OPENAI_PROJECT_KEY
EMBEDDING_API_KEY=REPLACE_SAME_OPENAI_PROJECT_KEY
RERANKER_API_KEY=REPLACE_EXISTING_SILICONFLOW_KEY_IF_ENABLED
# Static/session credentials are optional with AWS SDK workload identity.
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_SESSION_TOKEN=
OTEL_EXPORTER_OTLP_HEADERS=
