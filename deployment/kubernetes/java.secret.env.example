SPRING_DATASOURCE_URL=jdbc:postgresql://REPLACE_PG/deepresearch?sslmode=verify-full&sslrootcert=/run/certs/postgres-ca.pem
SPRING_DATASOURCE_PASSWORD=REPLACE_JAVA_PASSWORD
REDIS_URL=rediss://REPLACE_ACL_USER:REPLACE@REPLACE_REDIS:6379/0
# The Python baseline config uses an explicit OIDC CA. Supply a PKCS12 truststore
# containing that trust chain (and other required Java trust roots) in the trust Secret.
# For public system CAs, remove OIDC_CA_CERTS in the Python overlay and leave this empty.
# JAVA_TOOL_OPTIONS is echoed by the JVM: this public-CA-only truststore must use
# an independent integrity password, never a reused database/cloud/API credential.
JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/run/certs/oidc-truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=REPLACE_TRUSTSTORE_PASSWORD
