          }
        },
        "selector": {
          "matchLabels": {
            "app": "web"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "web"
            }
          },
          "spec": {
            "serviceAccountName": "deepresearch-web",
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 45,
            "containers": [
              {
                "name": "web",
                "image": "deepresearch-web:REPLACE_IMMUTABLE_TAG",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "deepresearch-web"
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "1Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "CHOWN",
                      "SETUID",
                      "SETGID",
                      "NET_BIND_SERVICE"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "nginx-config",
                    "mountPath": "/etc/nginx/conf.d"
                  },
                  {
                    "name": "nginx-cache",
                    "mountPath": "/var/cache/nginx"
                  },
                  {
                    "name": "nginx-run",
                    "mountPath": "/var/run"
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 80
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/nginx-livez",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "nginx-config",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "nginx-cache",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "nginx-run",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              }
            ],
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "topologySpreadConstraints": [
              {
                "maxSkew": 1,
                "topologyKey": "kubernetes.io/hostname",
                "whenUnsatisfiable": "ScheduleAnyway",
                "labelSelector": {
                  "matchLabels": {
                    "app": "web"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "web"
      },
      "spec": {
        "minAvailable": 1,
        "selector": {
          "matchLabels": {
            "app": "web"
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "deepresearch"
      },
      "spec": {
        "ingressClassName": "REPLACE_INGRESS_CLASS",
        "tls": [
          {
            "hosts": [
              "research.example.invalid"
            ],
            "secretName": "deepresearch-ingress-tls"
          }
        ],
        "rules": [
          {
            "host": "research.example.invalid",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "web",
                      "port": {
                        "number": 80
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "application-ingress"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress"
        ],
        "ingress": []
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "web-ingress"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "web"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 80
              }
            ],
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "deepresearch-ingress": "true"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "backend-ingress"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "backend"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 8080
              }
            ],
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "web"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "agent-ingress"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "agent"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "ports": [
              {
                "protocol": "TCP",
                "port": 8000
              }
            ],
            "from": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "backend"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "private-metrics"
      },
      "spec": {
        "podSelector": {
          "matchExpressions": [
            {
              "key": "app",
              "operator": "In",
              "values": [
                "backend",
                "agent",
                "worker",
                "document-worker"
              ]
            }
          ]
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "deepresearch-monitoring": "true"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "prometheus"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 8000
              },
              {
                "protocol": "TCP",
                "port": 8001
              },
              {
                "protocol": "TCP",
                "port": 8080
              }
            ]
          }
        ]
      }
    }
  ]
}
