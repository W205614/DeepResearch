    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "agent"
      },
      "spec": {
        "selector": {
          "app": "agent"
        },
        "ports": [
          {
            "name": "http",
            "port": 8000,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "agent"
      },
      "spec": {
        "replicas": 2,
        "revisionHistoryLimit": 3,
        "progressDeadlineSeconds": 600,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        },
        "selector": {
          "matchLabels": {
            "app": "agent"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "agent"
            }
          },
          "spec": {
            "serviceAccountName": "deepresearch-python",
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 45,
            "containers": [
              {
                "name": "agent",
                "image": "deepresearch-python:REPLACE_IMMUTABLE_TAG",
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "deepresearch-python"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "deepresearch-python"
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "2Gi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "internal",
                    "mountPath": "/run/internal",
                    "readOnly": true
                  },
                  {
                    "name": "certificates",
                    "mountPath": "/run/certs",
                    "readOnly": true
                  }
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8000
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/livez",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "data",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "internal",
                "secret": {
                  "secretName": "deepresearch-internal",
                  "defaultMode": 292
                }
              },
              {
                "name": "certificates",
                "secret": {
                  "secretName": "deepresearch-trust",
                  "defaultMode": 292
                }
              }
            ],
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              },
              "runAsNonRoot": true,
              "fsGroup": 10001,
              "runAsUser": 10001
            },
            "topologySpreadConstraints": [
              {
                "maxSkew": 1,
                "topologyKey": "kubernetes.io/hostname",
                "whenUnsatisfiable": "ScheduleAnyway",
                "labelSelector": {
                  "matchLabels": {
                    "app": "agent"
                  }
                }
              }
            ]
          }
        }
      }
