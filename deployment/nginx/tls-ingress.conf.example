# Host-level Nginx example. Replace hostname/certificate paths and obtain a real certificate.
# The cloud Compose web service binds to 127.0.0.1:8080; adjust together with APP_PORT.
server {
    listen 80;
    server_name research.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name research.example.com;
    ssl_certificate /etc/ssl/deepresearch/fullchain.pem;
    ssl_certificate_key /etc/ssl/deepresearch/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 11m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # This is the public trust boundary: discard any client-supplied forwarding chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 650s;
    }
}
