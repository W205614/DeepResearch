# Copy to the ignored .env.cloud at the repository root. Placeholders are not working services.
# APP_PUBLIC_URL is checked by the offline preflight; configure its real TLS ingress separately.
APP_PUBLIC_URL=https://research.example.com
APP_PORT=8080
OIDC_ISSUER=https://identity.example.com/realms/deepresearch
OIDC_JWKS_URL=https://identity.example.com/realms/deepresearch/protocol/openid-connect/certs
# For a private identity CA, set /run/certs/oidc-ca.pem and mount the matching
# Java PKCS12 truststore through CLOUD_CERTIFICATES_DIR; keep both paths private.
OIDC_CA_CERTS=
JAVA_TOOL_OPTIONS=
OIDC_AUDIENCE=deepresearch-api
OIDC_CLIENT_ID=deepresearch-web
OIDC_SCOPES=openid profile email
OIDC_REGISTRATION_ENABLED=false
# Space-separated exact HTTPS origins for discovery and token endpoints; no wildcard.
OIDC_CONNECT_ORIGINS=https://identity.example.com

# Copy the database provider's trusted CA to postgres-ca.pem in this directory.
# The same read-only certificate directory is mounted into all database clients.
CLOUD_CERTIFICATES_DIR=./.env.cloud-certificates
# Private-CA Java example (fill a private truststore password locally):
# The JVM echoes JAVA_TOOL_OPTIONS; use a public-CA-only store and independent
# integrity password, never a database/cloud/API credential.
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/run/certs/oidc-truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=REPLACE_TRUSTSTORE_PASSWORD
# Dedicated database; URL-encode passwords in DSNs. Keep these three roles separate.
PYTHON_DATABASE_URL=postgresql://dr_python:REPLACE_WITH_PASSWORD@postgres.example.com:5432/deepresearch?sslmode=verify-full&sslrootcert=/run/certs/postgres-ca.pem
MIGRATOR_DATABASE_URL=postgresql+psycopg://dr_migrator:REPLACE_WITH_PASSWORD@postgres.example.com:5432/deepresearch?sslmode=verify-full&sslrootcert=/run/certs/postgres-ca.pem
JAVA_DATABASE_URL=jdbc:postgresql://postgres.example.com:5432/deepresearch?sslmode=verify-full&sslrootcert=/run/certs/postgres-ca.pem
JAVA_DB_PASSWORD=
REDIS_URL=rediss://dr_queue:REPLACE_WITH_PASSWORD@redis.example.com:6379/0
REDIS_SSL_CA_CERTS=
MILVUS_URI=https://milvus.example.com
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_SERVER_PEM_PATH=
VECTOR_COLLECTION_PREFIX=dr
# ClamAV INSTREAM is unauthenticated: private network only, never expose 3310 publicly.
CLAMAV_HOST=clamav.internal.example.com
CLAMAV_PORT=3310

# Leave endpoint empty for AWS S3. Other providers must implement the S3 operations in the guide.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=ap-southeast-1
OBJECT_STORE_BUCKET=deepresearch-documents
OBJECT_STORE_ADDRESSING_STYLE=auto
# Both empty -> Boto3 default credential chain, including workload identity.
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_SESSION_TOKEN=
OBJECT_STORE_SSE=
OBJECT_STORE_KMS_KEY_ID=
AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
AWS_ROLE_ARN=
AWS_WEB_IDENTITY_TOKEN_FILE=

LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_MODEL_ID=gpt-6.1-sol
LLM_REASONING_EFFORT=low
LLM_API_KEY=
LLM_EXTRA_BODY={}
VISION_MODEL_ID=gpt-6.1-sol
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
EMBEDDING_API_KEY=
SEND_EMBEDDING_DIMENSIONS=true
WEB_SEARCH_PROVIDER=openai
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_API_KEY=
RERANKER_ENABLED=false
RERANKER_API_KEY=
ALLOW_INTERNAL_MODEL_PROCESSING=false
PLATFORM_OPERATOR_SUBJECTS=

# OTLP/gRPC only. Headers use the SDK format, e.g. Authorization=Bearer%20TOKEN.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_CERTIFICATE=

DEPLOYMENT_ID=deepresearch
PLATFORM_ACTIVE_RUN_LIMIT=5
MAX_CONCURRENT_RUNS=3
RESEARCH_WORKER_MAX_JOBS=3
WORKER_DRAIN_SECONDS=30
