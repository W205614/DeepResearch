From e1c9934f9f11a499029abb020ea715a08970da80 Mon Sep 17 00:00:00 2001
From: dan <Dan Kennedy>
Date: Tue, 4 Aug 2026 11:04:17 +0000
Subject: [PATCH] In fts5, account for the possibility of negative docids when
 allocating a buffer to store the results of merging detail=none prefix lists.
 Fix for report [bugs:/info/2026-08-04T08:49:27Z | 2026-08-04T08:49:27Z].

FossilOrigin-Name: a7f8c92f623e9cbe8a61266d949916acc9e5110c94dff4aa6fd1ad2ea8a60d4e
---
 ext/fts5/fts5_index.c          |  6 +++---
 ext/fts5/test/fts5prefix2.test | 17 +++++++++++++++++
 manifest                       | 15 +++++++--------
 manifest.uuid                  |  2 +-
 4 files changed, 28 insertions(+), 12 deletions(-)

diff --git a/ext/fts5/fts5_index.c b/ext/fts5/fts5_index.c
index 05a61aeb9a..eb03e0daa6 100644
--- a/ext/fts5/fts5_index.c
+++ b/ext/fts5/fts5_index.c
@@ -6105,7 +6105,7 @@ static void fts5MergeRowidLists(
   (void)nBuf;
   memset(&out, 0, sizeof(out));
   assert( nBuf==1 );
-  sqlite3Fts5BufferSize(&p->rc, &out, p1->n + p2->n);
+  sqlite3Fts5BufferSize(&p->rc, &out, p1->n + p2->n + 9);
   if( p->rc ) return;
 
   fts5NextRowid(p1, &i1, &iRowid1);
@@ -6113,12 +6113,12 @@ static void fts5MergeRowidLists(
   while( i1>=0 || i2>=0 ){
     if( i1>=0 && (i2<0 || iRowid1<iRowid2) ){
       assert( iOut==0 || iRowid1>iOut );
-      fts5BufferSafeAppendVarint(&out, iRowid1 - iOut);
+      fts5BufferSafeAppendVarint(&out, (u64)iRowid1 - (u64)iOut);
       iOut = iRowid1;
       fts5NextRowid(p1, &i1, &iRowid1);
     }else{
       assert( iOut==0 || iRowid2>iOut );
-      fts5BufferSafeAppendVarint(&out, iRowid2 - iOut);
+      fts5BufferSafeAppendVarint(&out, (u64)iRowid2 - (u64)iOut);
       iOut = iRowid2;
       if( i1>=0 && iRowid1==iRowid2 ){
         fts5NextRowid(p1, &i1, &iRowid1);
diff --git a/ext/fts5/test/fts5prefix2.test b/ext/fts5/test/fts5prefix2.test
index 0860b3cddd..e9b6545183 100644
--- a/ext/fts5/test/fts5prefix2.test
+++ b/ext/fts5/test/fts5prefix2.test
@@ -80,6 +80,23 @@ foreach {tn newrowid} {
   } $newrowid
 }
 
+#-------------------------------------------------------------------------
+foreach_detail_mode $::testprefix-4 {
+  reset_db
+  do_execsql_test 1 {
+    CREATE VIRTUAL TABLE t1 USING fts5(x, detail=%DETAIL%);
+    WITH RECURSIVE c(x) AS (
+        VALUES(1) UNION ALL SELECT x+1 FROM c WHERE x<55
+    )
+    INSERT INTO t1(rowid, x) SELECT x,'ab' FROM c;
+    INSERT INTO t1(rowid, x) VALUES(-9223372036854775808,'abc');
+  }
+
+  do_execsql_test 2 {
+    SELECT count(*) FROM t1('a*')
+  } {56}
+}
+
 finish_test
 
 
