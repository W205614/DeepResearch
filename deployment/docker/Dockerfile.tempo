FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOWORK=off GOMAXPROCS=2 GOMEMLIMIT=1024MiB
RUN test "$(go env GOVERSION)" = go1.27.3
RUN apk add --no-cache git
WORKDIR /source
RUN git init && git remote add origin https://github.com/grafana/tempo.git \
    && git -c http.version=HTTP/1.1 fetch --depth=1 origin refs/tags/v2.10.10:refs/tags/v2.10.10 \
    && test "$(git rev-parse refs/tags/v2.10.10)" = bbe3be0e055f387b13a3ce45ecbecb0a9c997ae2 \
    && test "$(git rev-parse 'refs/tags/v2.10.10^{commit}')" = f317720e7e5191a7f282e8f7d6fe5387ae6015b4 \
    && git checkout --detach f317720e7e5191a7f282e8f7d6fe5387ae6015b4
COPY deployment/vendors/tempo/go.mod deployment/vendors/tempo/go.sum /source/
RUN --mount=type=cache,target=/go/pkg/mod,id=dr-telemetry-go-mod-20261028 \
    --mount=type=cache,target=/root/.cache/go-build,id=dr-telemetry-go-build-20261028 \
    go build -p=2 -mod=readonly -buildvcs=true -trimpath \
      -ldflags='-s -w -X main.Branch=v2.10.10-security -X main.Revision=f317720e -X main.Version=2.10.10' \
      -o /out/tempo ./cmd/tempo \
    && go version -m /out/tempo | tee /out/buildinfo.txt \
    && grep -F 'github.com/go-jose/go-jose/v4' /out/buildinfo.txt | grep -F 'v4.1.6' \
    && grep -F 'golang.org/x/net' /out/buildinfo.txt | grep -F 'v0.62.0'
FROM grafana/tempo:2.10.10@sha256:12b0820f13ffa10ce956b6e9acc3b03f3cffded99109be6cc09d106fe56e5d38 AS runtime-base
FROM debian:trixie-slim@sha256:38a76d01668772e381ad2826d876627c89e7133e2f8a0f5d567306798b0f2a16 AS timezone-data
RUN apt-get update && apt-get install -y --no-install-recommends python3
ADD --checksum=sha256:3254eb870c8a949518214805aee5e4276af7699988ea8b9a3a583cd0f1eab31c https://security.debian.org/debian-security/pool/updates/main/t/tzdata/tzdata_2026f-0+deb12u1_all.deb /tmp/tzdata.deb
RUN dpkg-deb -x /tmp/tzdata.deb /package-source \
    && dpkg-deb -e /tmp/tzdata.deb /package-control \
    && mkdir -p /package-source/var/lib/dpkg/info \
    && cp /package-control/md5sums /package-source/var/lib/dpkg/info/tzdata.md5sums
COPY scripts/prepare_runtime_trust.py deployment/vendors/runtime-data/prepare_tempo_overlay.py /tmp/
COPY --from=runtime-base / /runtime-root/
RUN python3 /tmp/prepare_tempo_overlay.py
FROM timezone-data AS timezone-package
COPY --from=build /out/buildinfo.txt /runtime-overlay/usr/share/tempo/security-buildinfo.txt
FROM runtime-base
COPY --from=build /out/tempo /tempo
COPY --from=build /source/LICENSE /usr/share/licenses/tempo/LICENSE
COPY --from=timezone-package /runtime-overlay/ /
LABEL org.opencontainers.image.source="https://github.com/W205614/DeepResearch" \
      org.opencontainers.image.version="2.10.10-security-20261028" \
      org.opencontainers.image.description="Tempo 2.10.10 maintainer rebuild with locked security dependencies"
