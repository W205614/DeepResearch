# Unapproved candidate only. No existing exact-artifact authorization is inherited.
ARG RETAINED_ASSET_IMAGE=deepresearch-approved-grafana:20261107
FROM ${RETAINED_ASSET_IMAGE} AS retained
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS toolchain
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2 GOFLAGS=-p=2 GOMEMLIMIT=768MiB GOPROXY=https://proxy.golang.org
RUN apk add --no-cache git python3
FROM toolchain AS assets
COPY --from=retained /usr/share/grafana/data/plugins-bundled/ /reviewed-plugins/
COPY deployment/vendors/grafana-20261107/plugin-modules.json deployment/vendors/grafana-20261107/verify_retained_assets.py /tools/
RUN python3 /tools/verify_retained_assets.py
FROM toolchain AS build
WORKDIR /source
# The fixed source transport contains real upstream Git objects, verified before
# the build; fetching one monolithic pack was truncated by the current network.
COPY --from=grafanasource / /prefetched-grafana.git/
RUN git clone --no-hardlinks --branch v13.2.5 /prefetched-grafana.git /source \
    && test "$(git rev-parse HEAD)" = ce471d869a4810cd83c987dd3521c4b67689dbb6 \
    && git remote set-url origin https://github.com/grafana/grafana.git \
    && git config core.hooksPath /dev/null \
    && git fsck --full \
    && git diff --exit-code \
    && test -z "$(git status --porcelain=v1 --untracked-files=all)"
COPY --from=moduletransport / /prefetched-proxy/
COPY --from=thrifttransport / /prefetched-proxy/
ENV GOPROXY=file:///prefetched-proxy,https://proxy.golang.org
COPY deployment/vendors/grafana/main/ ./
COPY deployment/vendors/grafana-20261107/main/ ./
COPY deployment/vendors/grafana-20261110/main/ ./
COPY deployment/vendors/grafana-20261107/build_candidate_backends.py /tools/
COPY deployment/vendors/grafana-20261107/prepare_rebuild.py deployment/vendors/grafana-20261107/capture_graphs.py deployment/vendors/grafana-20261107/plugin-modules.json /tools/
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    python3 /tools/build_candidate_backends.py --prepare-source /source --receipt /out/checksum-preparation/main.json
COPY --from=retained /usr/share/grafana/data/plugins-bundled/ /rebuilt/
COPY --from=assets /reviewed-plugins/ /reviewed-plugins/
RUN python3 /tools/prepare_rebuild.py --inventory /tools/plugin-modules.json \
    --upstream /reviewed-plugins --rebuilt /rebuilt \
    --source /source/pkg/plugins/manager/signature/manifest.go --output /generated \
    && cp /generated/*.go /source/pkg/plugins/manager/signature/
COPY deployment/vendors/grafana/reviewed_backend_verifier.go deployment/vendors/grafana/reviewed_backend_verifier_test.go /source/pkg/plugins/manager/signature/
RUN gofmt -w /source/pkg/plugins/manager/signature/reviewed_backend*.go
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go test -mod=readonly ./pkg/plugins/manager/signature -run TestMaintainerReviewedBackendIntegrity -count=1 \
    && go build -mod=readonly -buildvcs=true -trimpath \
       -ldflags='-s -w -X main.version=13.2.5 -X main.commit=ce471d869a4810cd83c987dd3521c4b67689dbb6 -X main.buildBranch=maintainer-security-20261110' \
       -o /out/grafana ./pkg/cmd/grafana \
    && go version -m /out/grafana > /out/build-info.txt \
    && grep -F 'vcs.revision=ce471d869a4810cd83c987dd3521c4b67689dbb6' /out/build-info.txt
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    python3 /tools/capture_graphs.py --source /source --package ./pkg/cmd/grafana --target main --output /out/graphs
COPY deployment/vendors/grafana-20261107/verify_native_versions.py /tools/
RUN python3 /tools/verify_native_versions.py --root /rebuilt --inventory /tools/plugin-modules.json --main /out/grafana --output /out/native-version-verification.json
ARG PROJECT_SOURCE_REVISION=uncommitted-validation-inputs
ARG PROJECT_INPUTS_SHA256=unrecorded-validation-inputs
LABEL org.deepresearch.project.source_revision="${PROJECT_SOURCE_REVISION}" org.deepresearch.project.inputs_sha256="${PROJECT_INPUTS_SHA256}" org.deepresearch.upstream.grafana_revision="ce471d869a4810cd83c987dd3521c4b67689dbb6"

FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS busybox-fix
COPY deployment/vendors/grafana-20261110/busybox/ /recipe/
COPY --from=busyboxtransport / /recipe/inputs/
RUN sh /recipe/build.sh
RUN find /out/licenses /out/corresponding-source -type f -exec chmod 0644 {} + && \
    find /out/licenses /out/corresponding-source -type d -exec chmod 0755 {} +
RUN --network=none python3 /recipe/regression.py > /out/metadata/regression.json

FROM retained AS source-runtime
USER 0
COPY --from=build /out/grafana /usr/share/grafana/bin/grafana
COPY --from=build /out/build-info.txt /usr/share/deepresearch/grafana-candidate/build-info/main.txt
COPY --from=build /out/native-version-verification.json /usr/share/deepresearch/grafana-candidate/native-version-verification.json
COPY --from=build /generated/rebuild-provenance.json /usr/share/deepresearch/grafana-candidate/provenance/rebuild-provenance.json
COPY --from=build /out/graphs/*.json.gz /out/graphs/*.receipt.json /usr/share/deepresearch/grafana-candidate/graphs/main/
COPY --from=build /out/graphs/locks/ /usr/share/deepresearch/grafana-candidate/actual-locks/main/
COPY --from=build /out/checksum-preparation/ /usr/share/deepresearch/grafana-candidate/checksum-preparation/main/
COPY --from=busybox-fix /out/busybox /bin/busybox
COPY --from=busybox-fix /out/licenses/ /usr/share/deepresearch/grafana-candidate/busybox/licenses/
COPY --from=busybox-fix /out/corresponding-source/ /usr/share/deepresearch/grafana-candidate/busybox/corresponding-source/
COPY --from=busybox-fix /out/metadata/build.json /usr/share/deepresearch/grafana-candidate/busybox/build.json
COPY --chmod=0644 deployment/vendors/grafana-20261110/source.lock.json /usr/share/deepresearch/grafana-candidate/source.lock.json
USER 472
ARG PROJECT_SOURCE_REVISION=uncommitted-validation-inputs
ARG PROJECT_INPUTS_SHA256=unrecorded-validation-inputs
LABEL org.deepresearch.project.source_revision="${PROJECT_SOURCE_REVISION}" org.deepresearch.project.inputs_sha256="${PROJECT_INPUTS_SHA256}" org.deepresearch.upstream.grafana_revision="ce471d869a4810cd83c987dd3521c4b67689dbb6"
LABEL org.opencontainers.image.revision="${PROJECT_SOURCE_REVISION}" org.opencontainers.image.version="13.2.5-source-maintenance-20261110"
# Full regression receipts contain random loopback ports. Retain them as external
# evidence instead of changing runtime bytes on every build. Only complete source
# materials and stable source/build metadata accompany this local source runtime.
