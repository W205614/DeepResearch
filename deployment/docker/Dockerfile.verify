FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv
FROM deepresearch-verify-base
USER root
COPY --from=uv /uv /usr/local/bin/uv
RUN ["uv", "sync", "--frozen", "--all-groups", "--no-install-project", "--no-python-downloads", "--link-mode=copy"]
COPY . /app
USER 10001:10001
